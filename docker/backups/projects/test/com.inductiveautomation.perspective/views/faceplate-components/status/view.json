{
  "custom": {},
  "params": {
    "tagpath": "[default]V410"
  },
  "propConfig": {
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 804
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "props": {
          "text": "Status"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Multi-port valve status display"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.status[0].status": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagpath": "{view.params.tagpath}"
                },
                "tagPath": "{tagpath}/status/actFB"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "status": [
            {
              "label": "Act FB",
              "lowlight": false
            }
          ]
        },
        "type": "hmi.display.StatusValveMp"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}