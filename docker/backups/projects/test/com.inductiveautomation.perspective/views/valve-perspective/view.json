      "height": 48,
      "width": 24
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "multi-port-process-valve"
        },
        "position": {
          "basis": "40px",
          "grow": 1
        },
        "propConfig": {
          "props.processObject": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagpath": "{view.params.value.tagpath}"
                },
                "tagPath": "{tagpath}"
              },
              "type": "tag"
            }
          }
        },
        "type": "hmi.process_objects.Valve_mp"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
